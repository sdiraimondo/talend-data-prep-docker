###############################################
# Dockerfile.dev — variante DEV, multi-arch (amd64/arm64)
# Stage unique, `npm run serve` expose sur 3000.
# Meme logique TARGETARCH / fallback uname -m que le Dockerfile prod.
###############################################
FROM debian:stretch-slim

# ARG doit etre declare apres le FROM pour etre visible dans ce stage.
ARG TARGETARCH

ENV NODE_VERSION=10.24.1 \
    YARN_VERSION=1.2.1

RUN apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates \
        curl \
        git \
        xz-utils \
    && rm -rf /var/lib/apt/lists/*

# Utilisateur non-root (uid 1000) — identique a l'original.
RUN groupadd --gid 1000 node \
    && useradd --uid 1000 --gid node --shell /bin/bash --create-home node

# --- Installation de Node.js selon TARGETARCH (fallback uname -m) ---
RUN set -eux; \
    case "${TARGETARCH:-}" in \
      amd64) NODE_ARCH=x64 ;; \
      arm64) NODE_ARCH=arm64 ;; \
      "")    HOST_MACHINE=$(uname -m); \
             case "$HOST_MACHINE" in \
               x86_64)  NODE_ARCH=x64 ;; \
               aarch64) NODE_ARCH=arm64 ;; \
               *) echo "Architecture non supportee : $HOST_MACHINE" >&2; exit 1 ;; \
             esac ;; \
      *) echo "TARGETARCH non supporte : ${TARGETARCH}" >&2; exit 1 ;; \
    esac; \
    echo "==> Installation Node ${NODE_VERSION} (linux-${NODE_ARCH})"; \
    curl -fsSLO "https://nodejs.org/dist/v${NODE_VERSION}/node-v${NODE_VERSION}-linux-${NODE_ARCH}.tar.xz"; \
    tar -xJf "node-v${NODE_VERSION}-linux-${NODE_ARCH}.tar.xz" -C /usr/local --strip-components=1; \
    rm "node-v${NODE_VERSION}-linux-${NODE_ARCH}.tar.xz"; \
    ln -s /usr/local/bin/node /usr/local/bin/nodejs

# --- Yarn 1.2.1 (tarball unique) ---
RUN set -eux; \
    curl -fsSLO "https://github.com/yarnpkg/yarn/releases/download/v${YARN_VERSION}/yarn-v${YARN_VERSION}.tar.gz"; \
    mkdir -p /opt/yarn; \
    tar -xzf "yarn-v${YARN_VERSION}.tar.gz" -C /opt/yarn --strip-components=1; \
    ln -s /opt/yarn/bin/yarn /usr/local/bin/yarn; \
    rm "yarn-v${YARN_VERSION}.tar.gz"

WORKDIR /var/local/pontusvision-extract-discovery

# Clone Git, puis npm install en utilisateur node.
RUN git clone --depth 1 https://github.com/Talend/data-prep.git /var/local/pontusvision-extract-discovery \
    && chown -R node:node /var/local/pontusvision-extract-discovery

USER node

RUN npm install

VOLUME ["/var/local/pontusvision-extract-discovery"]
EXPOSE 3000/tcp

CMD ["npm", "run", "serve"]
